# Optional overrides for docker compose. Copy to .env (git-ignored). Every value is optional.
# Development-only SA password (no ";" or "$": it is embedded in the connection string).
MSSQL_SA_PASSWORD=Dev_Passw0rd!
# Host ports, change them if one is already in use.
UI_PORT=8080
API_PORT=5280
DB_PORT=1433
# Development enables the OpenAPI UI at http://localhost:<API_PORT>/scalar/v1.
API_ENVIRONMENT=Production
